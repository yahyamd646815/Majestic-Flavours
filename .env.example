# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real keys.

# Clerk — Dashboard → API Keys → Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase — Dashboard → Project Settings → API
# Only the anon key belongs here. The service role key must NEVER be used in
# client code — Row Level Security is what restricts what the anon key can do.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog — Project Settings → Project API key
# This is the project API key (client-side, safe here), not a personal API key.
# The host depends on the region the project was created in:
#   US → https://us.i.posthog.com     EU → https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=